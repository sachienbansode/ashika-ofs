# End-to-end run. Local scratch database only — never point this at production.
NODE_ENV=test
PORT=3199
OFS_PG_HOST=/tmp
OFS_PG_PORT=55445
OFS_PG_DATABASE=ofs_bids
OFS_PG_USER=ofsapp
ANANTA_PG_HOST=/tmp
ANANTA_PG_PORT=55445
ANANTA_PG_DATABASE=uat_ananta_staging
ANANTA_PG_USER=ofsapp
JWT_SECRET=e2e-only-not-a-real-secret-0123456789
JWT_ISSUER=omnenest-staging-api
CLIENT_JWT_SECRET=e2e-only-client-secret-9876543210
COOKIE_SECURE=false
APP_URL=http://localhost:3199
# Returns the confirmation code in the response instead of emailing it.
# Floored off when NODE_ENV=production — see lib/otp.isProduction.
OFS_OTP_TEST_MODE=true
