# ---- App ----
# 'production' locks out OFS_OTP_TEST_MODE entirely. Use uat or staging while
# testing, and set production before go-live. PM2 no longer hardcodes this, so
# .env is the only place it is decided.
NODE_ENV=production
PORT=4011
HOST=127.0.0.1
APP_NAME=ashika-ofs-app
PUBLIC_BASE_URL=https://ofs.example.com

# =====================================================================
# TWO databases, both on the prod box 13.233.106.37. Postgres cannot join
# across databases, so client identity is read from ANANTA and merged in
# the app (db/ldAdapter.js) - never copied into the OFS database.
# =====================================================================

# ---- DB 1: OFS state (owned by this app) ----
# Confirmed on the prod server: database `ofs_bids` (underscore).
OFS_DATABASE_URL=postgresql://root_admin@13.233.106.37:5432/ofs_bids
OFS_PG_PASSWORD=
OFS_PG_SSL=true
OFS_PG_POOL_MAX=10
OFS_SCHEMA=ofs
# (or drop the URL and use discrete vars instead:)
# OFS_PG_HOST=13.233.106.37
# OFS_PG_PORT=5432
# OFS_PG_DATABASE=ofs_bids
# OFS_PG_USER=root_admin

# ---- DB 2: Ananta - LD/DWH client data + platform meta schema ----
# uat_ananta_staging is the PRODUCTION database despite its name.
# The OFS app only READS dwh/stg here; it writes nothing but its page-registry rows.
ANANTA_DATABASE_URL=postgresql://root_admin@13.233.106.37:5432/uat_ananta_staging
ANANTA_PG_PASSWORD=
ANANTA_PG_SSL=true
ANANTA_PG_POOL_MAX=5
# root_admin is the platform's admin login and works, but this app only needs
# SELECT on dwh/stg + the admin schema and INSERT/UPDATE on page_registry.
# A scoped role (e.g. ofs_reader) is the safer credential for a prod LD connection.
DWH_SCHEMA=dwh
STG_SCHEMA=stg
ADMIN_SCHEMA=admin-staging-api

# Keep the password OUT of the URL: <PREFIX>_PG_PASSWORD is applied after the URL
# is parsed and overrides anything embedded in it.

# ---- Auth (same JWT issuer as the staging-api platform) ----
JWT_SECRET=
JWT_ISSUER=omnenest-staging-api
SESSION_IDLE_MIN=15

# ---- Email (reuses the platform's SMTP config; OFS stores no credentials) ----
# Settings come from "admin-staging-api".smtp_settings (id=1) in the Ananta DB.
# The stored password is AES-256-GCM sealed with API_KEY_SECRET, so this MUST be
# byte-identical to the platform's value or the password will not decrypt.
API_KEY_SECRET=
# Public URL used in email header/footer links, and for the logo:
APP_URL=https://ofs-bids.ashikagroup.com
# BRAND_LOGO_URL=            # optional override; defaults to APP_URL/brand-logo.png

# ---- Staff sign-in: two doors to /desk ----
# 1. Direct sign-in at /desk/login.html — email + portal password, plus a one-time
#    code when the role or the account demands one. It verifies against the SAME
#    platform accounts ("admin-staging-api".users); OFS stores no staff password.
#    Set false once portal SSO is deployed and you want one door only.
OFS_STAFF_LOGIN=true
#
# 2. Single sign-on from the portal (preferred: no second password prompt).
# The portal authenticates (password + OTP where the account requires it), mints a
# 60s single-use ticket and redirects here.
# Generate once with: openssl rand -base64 48
# The SAME value must be set in the platform's .env as OFS_SSO_SECRET.
OFS_SSO_SECRET=
# Shown as "Go to the portal" on a failed sign-in:
PORTAL_URL=https://staging-api-uat.ashikagroup.com
# Session cookie issued by this app (the portal's own cookie cannot reach it):
SESSION_COOKIE=ofs_session
JWT_EXPIRES_IN=8h
# TLS. Both are flipped for you by `bash scripts/enable-https.sh <domain>`, which
# refuses to run until a certificate is actually being served — setting them without
# one takes the site down rather than securing it (the browser stops sending the
# session cookie, and the page asks for assets over a port that is not listening).
# COOKIE_SECURE=true  -> the session cookie is TLS-only
# FORCE_HTTPS=true    -> HSTS + upgrade-insecure-requests in the CSP
COOKIE_SECURE=false
FORCE_HTTPS=false

# ---- Client sign-in (mobile + email + OTP) ----
# Clients are NOT platform users: separate cookie, separate tables, no page grants.
CLIENT_COOKIE=ofs_client
CLIENT_SESSION_HOURS=2
# Defaults to JWT_SECRET if unset; a separate value keeps client and staff tokens
# cryptographically unrelated:
CLIENT_JWT_SECRET=
OFS_OTP_TTL_MIN=5
OFS_OTP_MAX_ATTEMPTS=5
OFS_OTP_RESEND_S=60
# Testing only. Ignored whenever NODE_ENV=production, whatever this says — a fixed
# OTP on a live desk would be an open door. Leave false unless you are testing.
OFS_OTP_TEST_MODE=false
OFS_OTP_TEST_CODE=123456

# SMS: the code goes to the registered email AND mobile. No provider is wired yet,
# so the mobile leg is skipped and email carries it — email alone is enough to sign
# in. Implement a provider in lib/sms.js and set these:
# SMS_PROVIDER=
# SMS_API_KEY=

# ---- CORS: explicit allow-list, no origin reflection ----
CORS_ORIGINS=https://ofs-bids.ashikagroup.com

# ---- Exchange ----
BSE_MEMBER_CODE=
# Fetching the issue master from the exchange WEBSITES is off by default and should
# stay off. NSE and BSE both prohibit "systematic or automated data collection"
# without prior written permission, and BSE restricts its site to non-commercial
# use. As a SEBI-registered member the sanctioned routes are the e-OFS/iBBS
# terminals, the member extranet, and the T-2/T-1 notices — feed those in through
# Masters → Import issues CSV. Turn this on only with written consent from the
# exchange, or against a permitted endpoint.
EXCHANGE_WEB_FETCH=false

# ---- OFS business defaults (overridable in ofs.ofs_setting) ----
OFS_RETAIL_CAP=200000
OFS_HNI_MIN=200000
OFS_DAILY_CUTOFF=15:15
OFS_ENFORCE_MARGIN=1
