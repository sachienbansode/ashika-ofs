# ---- App ----
NODE_ENV=production
PORT=4011
HOST=127.0.0.1
APP_NAME=ashika-ofs-app
PUBLIC_BASE_URL=https://ofs.example.com

# ---- Ananta Postgres (shared instance; OFS uses its own `ofs` schema) ----
PG_HOST=13.233.106.37
PG_PORT=5432
PG_DATABASE=uat_ananta_staging
PG_USER=
# password supplied via PGPASSWORD env var, never in a DSN
PGPASSWORD=
PG_SSL=false
PG_POOL_MAX=10

# Schemas consumed (read-only) and owned
OFS_SCHEMA=ofs
DWH_SCHEMA=dwh
STG_SCHEMA=stg
ADMIN_SCHEMA=admin-staging-api

# ---- Auth (same JWT issuer as the staging-api platform) ----
JWT_SECRET=
JWT_ISSUER=omnenest-staging-api
SESSION_IDLE_MIN=15

# ---- CORS: explicit allow-list, no origin reflection ----
CORS_ORIGINS=https://ofs.example.com

# ---- OFS business defaults (overridable in ofs.ofs_setting) ----
OFS_RETAIL_CAP=200000
OFS_HNI_MIN=200000
OFS_DAILY_CUTOFF=15:15
OFS_ENFORCE_MARGIN=1
